# Required: set at least one model provider key
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional model override (see README for defaults)
# MASTRA_MODEL=xai/grok-4.3

# Optional libSQL storage URL (default: file:./agent-office.db)
# AGENT_OFFICE_DB_URL=file:./agent-office.db

# Optional Mastra memory resource id (default: agent-office)
# AGENT_OFFICE_RESOURCE_ID=agent-office